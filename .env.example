# ─────────────────────────────────────────────────────────────
#  Get Your Credit Poppin — email settings (Nodemailer + Gmail)
#  Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────

# Gmail account that SENDS the emails
GMAIL_USER=websitenotifcation001@gmail.com

# 16-character Gmail App Password (NOT your normal Gmail password)
# Create one at https://myaccount.google.com/apppasswords
# (2-Step Verification must be ON for the Gmail account)
GMAIL_APP_PASSWORD=paut qeho pggl nssy

# Gmail SMTP server (leave as-is)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Where new lead notifications are delivered (can be any inbox)
CONTACT_TO_EMAIL=getyourcredipoppin@gmail.com

# Name shown in the "From" field
CONTACT_FROM_NAME=Get Your Credit Poppin

# Send an automatic "we got your request" email to the visitor (true/false)
SEND_AUTO_REPLY=true

# Public site URL (used for SEO / social sharing)
NEXT_PUBLIC_SITE_URL=https://getyourcreditpoppin.com
